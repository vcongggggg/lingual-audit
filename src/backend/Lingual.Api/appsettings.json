{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Lingual": "Debug"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=lingual_db;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "Lingual.Api",
    "Audience": "Lingual.Clients",
    "Key": "YOUR_JWT_SECRET_KEY_MIN_32_CHARS_LONG_FOR_DEV_ENVIRONMENT!",
    "ExpiryDays": 7
  },
  "Mezon": {
    "AppId": "YOUR_MEZON_APP_ID",
    "BotId": "YOUR_MEZON_BOT_ID",
    "Token": "YOUR_MEZON_BOT_TOKEN",
    "McpPort": 3179,
    "ClanId": "YOUR_MEZON_CLAN_ID",
    "DefaultChannelId": "YOUR_MEZON_DEFAULT_CHANNEL_ID"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "https://mezon.ai"
    ]
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "Model": "gemini-3.1-flash-lite",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta"
  }
}
