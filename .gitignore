yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.next/
out/
build/
dist/
.turbo/
.cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
