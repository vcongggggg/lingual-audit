# ==============================================================================
# MEZON CAMPUS STUDIO 2026 - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env và điền các giá trị thực tế của bạn
# ==============================================================================

# --- MÔI TRƯỜNG CHẠY ---
NODE_ENV=development
APP_ENV=local
DEBUG=True
PORT=3000
HOST=127.0.0.1

# --- MEZON PLATFORM CREDENTIALS ---
# Lấy từ cổng Developer Portal: https://mezon.ai hoặc Top Mezon Bot Admin
MEZON_BOT_TOKEN=your_mezon_bot_token_here
MEZON_APP_ID=your_mezon_app_id_here
MEZON_APP_SECRET=your_mezon_app_secret_here
MEZON_CLAN_ID=your_target_clan_id_here
MEZON_DEFAULT_CHANNEL_ID=your_default_channel_id_here

# --- DATABASE & CACHE ---
# Cấu hình CSDL PostgreSQL & Redis (hỗ trợ cả Docker lẫn Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mezon_campus_db
REDIS_URL=redis://localhost:6379/0

# --- SECURITY & AUTHENTICATION ---
JWT_SECRET=replace_with_a_super_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI & LLM PROVIDER (TÙY CHỌN TÍCH HỢP) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- THÔNG BÁO TIẾN ĐỘ & MONITORING (TELEGRAM INTEGRATION) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
